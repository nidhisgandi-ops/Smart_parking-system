# Dependencies — never commit these (Windows binaries break Linux/Vercel)
node_modules/
.pnp
.pnp.js

# Production build output — Vercel builds this itself
dist/
dist-ssr/
build/

# Environment variables — never commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vite / TypeScript cache
*.tsbuildinfo
vite.config.ts.timestamp-*

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
